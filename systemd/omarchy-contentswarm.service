[Unit]
Description=ContentSwarm deterministic Android phone service
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/omarchy/plugins/wearable.assistant/bin/omarchy-contentswarm-service
Restart=on-failure
RestartSec=5
Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target

