#!/bin/bash

# omarchy:summary=Talk to the Omarchy voice assistant daemon
# omarchy:args=ask <text> | note <text> | overheard <text> | ptt start [note]|stop | intake | review | accept|accept-calendar|dismiss|snooze|nudge|calendar <id> | digest | mine-now | recall <words> [--days N] | calendar-add <title> <when> | mail ... | secret <name> | approve <what> | browser attach [site]|detach|status | pair <device-id> [label] | listen [on|off|toggle] | listening | status [--json] | open-chat [chat-id]
# omarchy:examples=omarchy-assistant ask "remind me in 10 minutes to stretch" | omarchy-assistant pair phone | omarchy-assistant status

set -euo pipefail

RUN_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-assistant"
SOCK="$RUN_DIR/sock"
VAULT_DEFAULT="$HOME/Documents/Omarchy"

api() { # method path [json]
  local method=$1 path=$2 data=${3:-}
  if [[ -n $data ]]; then
    curl -sS --fail-with-body --unix-socket "$SOCK" -X "$method" -H 'Content-Type: application/json' --data "$data" "http://local$path"
  else
    curl -sS --fail-with-body --unix-socket "$SOCK" -X "$method" "http://local$path"
  fi
}

json_text() { jq -cn --arg t "$1" --arg m "$2" '{text:$t, mode:$m}'; }

need_daemon() {
  [[ -S $SOCK ]] || { echo "omarchy-assistant: daemon not running (systemctl --user start omarchy-assistant)" >&2; exit 1; }
}

vault_path() { jq -r --arg d "$VAULT_DEFAULT" '.vault // $d' "$HOME/.config/omarchy/assistant/config.json" 2>/dev/null || echo "$VAULT_DEFAULT"; }

cmd=${1:-}
shift || true

case $cmd in
ask | note | overheard)
  need_daemon
  text="$*"
  [[ -n $text ]] || text=$(cat)
  [[ -n $text ]] || exit 0
  api POST /local/text "$(json_text "$text" "$cmd")" >/dev/null
  ;;

ptt)
  # Hold-to-talk with a tap fallback, independent of voxtype's daemon so the
  # transcript is never typed into the focused window. Audio goes to a wav in
  # the runtime dir, `voxtype transcribe` turns it into text, the daemon gets
  # the text. One notification morphs Listening → Thinking → reply.
  mkdir -p "$RUN_DIR"
  wav="$RUN_DIR/ptt.wav" pidf="$RUN_DIR/ptt.pid" stamp="$RUN_DIR/ptt-started" modef="$RUN_DIR/ptt.mode" nidf="$RUN_DIR/ptt.nid"
  recording() { [[ -f $pidf ]] && kill -0 "$(cat "$pidf")" 2>/dev/null; }
  # The wav lives on the runtime tmpfs. An unbounded recorder once filled it
  # (793 MB) and every systemd transient unit on the machine failed, so the
  # recorder is hard-capped and finish() also reaps any stray one by pattern.
  MAX_RECORD_SEC=90
  toast() { omarchy-notification-send -r "$(cat "$nidf" 2>/dev/null || echo 0)" -u low --app-name Omarchy "$@" >/dev/null 2>&1 || true; }
  finish() {
    if ! recording; then
      pkill -INT -f "pw-record .*$wav" 2>/dev/null || true
      return 0
    fi
    kill -INT "$(cat "$pidf")" 2>/dev/null || true
    sleep 0.3
    pkill -INT -f "pw-record .*$wav" 2>/dev/null || true
    rm -f "$pidf" "$stamp"
    local mode nid text
    mode=$(cat "$modef" 2>/dev/null || echo ask)
    nid=$(cat "$nidf" 2>/dev/null || echo 0)
    toast -g 󰔟 "Thinking…" "transcribing"
    text=$(voxtype transcribe "$wav" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk 'body {print} /^$/ {body=1}' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | tr '\n' ' ')
    rm -f "$wav"
    if [[ -z ${text// /} ]]; then
      toast -t 3000 -g 󰍭 "Omarchy" "Didn't catch that"
      return 0
    fi
    api POST /local/text "$(jq -cn --arg t "$text" --arg m "$mode" --argjson n "$nid" '{text:$t, mode:$m, notifyId:$n}')" >/dev/null \
      || toast -t 4000 -g 󰅖 "Omarchy" "Daemon not running"
  }
  case ${1:-} in
  start)
    if recording; then finish; exit 0; fi
    mode=${2:-ask}
    echo "$mode" >"$modef"
    date +%s%3N >"$stamp"
    rm -f "$wav"
    pkill -INT -f "pw-record .*$wav" 2>/dev/null || true
    timeout -s INT "$MAX_RECORD_SEC" pw-record --rate 16000 --channels 1 --format s16 "$wav" >/dev/null 2>&1 &
    echo $! >"$pidf"
    omarchy-notification-send -p -g 󰍬 -u low --app-name Omarchy "$([[ $mode == note ]] && echo 'Note…' || echo 'Listening…')" "release, or tap again to send" >"$nidf" 2>/dev/null || echo 0 >"$nidf"
    ;;
  stop)
    now=$(date +%s%3N)
    started=$(cat "$stamp" 2>/dev/null || echo 0)
    ((now - started < 400)) && exit 0
    finish
    ;;
  *) echo "usage: omarchy-assistant ptt start [note]|stop" >&2; exit 1 ;;
  esac
  ;;

intake)
  # Kept for anyone who prefers voxtype's post_process hook. Beware: when the
  # hook returns nothing voxtype types the original text, so the default
  # install no longer uses this path.
  text=$(cat)
  armed=$(ls "$RUN_DIR"/armed-* 2>/dev/null | head -n1 || true)
  if [[ -z $armed ]]; then
    printf '%s' "$text"
    exit 0
  fi
  mode=${armed##*/armed-}
  rm -f "$armed"
  [[ -n ${text// /} ]] && api POST /local/text "$(json_text "$text" "$mode")" >/dev/null || true
  printf '%s' "$text"
  ;;

review)
  need_daemon
  while :; do
    pending=$(api GET /local/proposals | jq -c '.proposals')
    count=$(jq 'length' <<<"$pending")
    if ((count == 0)); then
      omarchy-notification-send -g 󰃰 "Omarchy" "Nothing to review"
      break
    fi
    id=$(jq -r '.[0].id' <<<"$pending")
    label=$(jq -r '.[0] | "\(.text)\(if .when then " 📅 " + .when else "" end)"' <<<"$pending")
    kind=$(jq -r '.[0].kind' <<<"$pending")
    quote=$(jq -r '.[0].quote' <<<"$pending")
    options=("󰄬	Add task" "󰅖	Dismiss" "󰏫	Open in Obsidian" "󰅁	Later")
    [[ -n $(jq -r '.[0].when // empty' <<<"$pending") ]] && options=("󰄬	Add task" "󰃭	Add task + calendar" "󰅖	Dismiss" "󰏫	Open in Obsidian" "󰅁	Later")
    choice=$(omarchy-menu-select "$label ($count to review)" "${options[@]}" || true)
    case $choice in
    "Add task") api POST "/local/proposal/$id/accept" >/dev/null ;;
    "Add task + calendar") api POST "/local/proposal/$id/accept-calendar" >/dev/null ;;
    Dismiss) api POST "/local/proposal/$id/dismiss" >/dev/null ;;
    "Open in Obsidian") xdg-open "obsidian://open?path=$(vault_path)/Proposals/$id.md"; break ;;
    *) break ;;
    esac
  done
  ;;

accept | accept-calendar | dismiss | snooze | nudge | calendar)
  need_daemon
  id=${1:?usage: omarchy-assistant $cmd <proposal-id>}
  api POST "/local/proposal/$id/$cmd"
  echo
  ;;

digest) need_daemon; api POST /local/digest; echo ;;

secret)
  # Store a secret in the GNOME keyring without it touching a file or a chat.
  #   omarchy-assistant secret api-token            (Forward Email API token)
  #   omarchy-assistant secret kelvin@aigentis.io   (an alias password)
  name=${1:?usage: omarchy-assistant secret <name>}
  if [[ -t 0 ]]; then read -rs -p "Secret for $name (hidden): " value; echo; else value=$(cat); fi
  [[ -n $value ]] || { echo "empty, nothing stored" >&2; exit 1; }
  printf '%s' "$value" | secret-tool store --label="Forward Email $name" service forwardemail account "$name"
  secret-tool lookup service forwardemail account "$name" >/dev/null && echo "stored: service=forwardemail account=$name"
  ;;


mail)
  # Compatibility entrypoint. All email mechanics and side effects live in
  # the deterministic kernel; the brain only interprets content and supplies
  # draft text.
  exec omarchy-mail-kernel "$@"
  ;;


calendar-add)
  # calendar-add "<title>" "<YYYY-MM-DDTHH:MM or YYYY-MM-DD>": Google Calendar event
  # (via the daemon's calendar step), an Inbox task, and nudges.
  need_daemon
  title=${1:?usage: omarchy-assistant calendar-add "<title>" "<YYYY-MM-DDTHH:MM>"}; when=${2:?when required}
  api POST /local/calendar "$(jq -cn --arg t "$title" --arg w "$when" '{text:$t, when:$w}')"
  echo
  ;;


recall)
  # Search the Obsidian vault: conversations, notes, overheard lines, tasks,
  # memory pages. Newest files first, output capped so it fits a prompt.
  # Usage: omarchy-assistant recall <words...> [--days N] [--limit N]
  days=0 limit=40 words=()
  while (($# > 0)); do
    case $1 in
    --days) days=${2:-0}; shift 2 ;;
    --limit) limit=${2:-40}; shift 2 ;;
    *) words+=("$1"); shift ;;
    esac
  done
  ((${#words[@]})) || { echo "usage: omarchy-assistant recall <words...> [--days N] [--limit N]" >&2; exit 1; }
  vault=$(vault_path)
  pattern=$(IFS='|'; echo "${words[*]}")
  finder=(find "$vault" -type f -name '*.md' -not -path '*/.obsidian/*' -not -path '*/Proposals/*')
  ((days > 0)) && finder+=(-mtime "-$days")
  # NUL-separated so vault paths with spaces survive; rg exits 1 on no match.
  "${finder[@]}" -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2- | tr '\n' '\0' \
    | xargs -0 -r rg -i -n --no-heading --color never --max-columns 240 -e "$pattern" 2>/dev/null \
    | sed "s|^$vault/||" | head -n "$limit" || true
  ;;


approve)
  # Human gate for login, payment, sending and deleting. Exit 0 = allowed.
  # An unattended laptop denies after 60 s; the menu may stay open until
  # dismissed, which is acceptable for a gate that defaulted to no.
  what=${*:?usage: omarchy-assistant approve <what the assistant wants to do>}
  omarchy-notification-send -g 󰌾 -u critical --app-name Omarchy "Omarchy wants to: $what" "Choose in the menu (denies in 60 s)" >/dev/null 2>&1 || true
  choice=$(timeout 60 omarchy-menu-select "Allow Omarchy to: $what" "󰄬	Allow" "󰅖	Deny" 2>/dev/null || true)
  omarchy-shell -q notifications dismissAll >/dev/null 2>&1 || true
  [[ $choice == Allow ]] && { echo allowed; exit 0; }
  echo denied
  exit 1
  ;;

browser)
  # attach: let the assistant drive the user's own logged-in Chromium over CDP.
  # Needs an explicit approval every time, and Chromium must be started with
  # the debugging port; an already-running Chromium without it cannot be
  # attached to, so the user is asked to close it first.
  port=9222
  case ${1:-} in
  attach)
    omarchy-assistant approve "use your logged-in Chromium (${2:-no site given})" >/dev/null || { echo "denied"; exit 1; }
    if curl -s --max-time 1 "http://127.0.0.1:$port/json/version" >/dev/null; then
      echo "attached: chromium already exposes port $port"
    elif pgrep -x chromium >/dev/null; then
      echo "cannot attach: Chromium is running without --remote-debugging-port. Ask the user to close Chromium, then retry."
      exit 2
    else
      uwsm-app -- chromium --remote-debugging-port=$port >/dev/null 2>&1 &
      for i in $(seq 1 20); do sleep 0.5; curl -s --max-time 1 "http://127.0.0.1:$port/json/version" >/dev/null && break; done
      curl -s --max-time 1 "http://127.0.0.1:$port/json/version" >/dev/null || { echo "chromium did not expose port $port"; exit 2; }
      echo "attached: launched chromium with --remote-debugging-port=$port"
    fi
    echo "next: agent-browser --cdp $port --pin-tab open <url>; finish with 'agent-browser --cdp $port tab close'. Never 'agent-browser close' here."
    ;;
  detach)
    # Nothing destructive: the assistant closes only its own pinned tab. The
    # debugging port stays open until Chromium is restarted without the flag.
    echo "detached: the user's Chromium stays open; agent tabs are closed with 'agent-browser --cdp $port tab close'"
    ;;
  status)
    curl -s --max-time 1 "http://127.0.0.1:$port/json/version" | jq -r '"debug port open: " + .Browser' 2>/dev/null || echo "debug port closed"
    ;;
  *) echo "usage: omarchy-assistant browser attach [site]|detach|status" >&2; exit 1 ;;
  esac
  ;;

mine-now) need_daemon; api POST /local/mine; echo ;;

pair)
  need_daemon
  dev=${1:?usage: omarchy-assistant pair <device-id> [label]}
  out=$(api POST /local/pair "$(jq -cn --arg d "$dev" --arg l "${2:-}" '{devId:$d, label:$l}')")
  echo "Paired device: $(jq -r .devId <<<"$out")"
  echo "Base URL:      $(jq -r .baseUrl <<<"$out")"
  echo "Token (shown once, enter it in the app): $(jq -r .token <<<"$out")"
  ;;

listen)
  case ${1:-toggle} in
  on) omarchy-toggle assistant-mute off ;;
  off) omarchy-toggle assistant-mute on ;;
  toggle) omarchy-toggle assistant-mute toggle ;;
  esac
  omarchy-shell -q wearable.assistant refresh >/dev/null 2>&1 || true
  omarchy-assistant listening && echo "Listening: on" || echo "Listening: off"
  ;;
listening) ! omarchy-toggle-enabled assistant-mute ;;

status)
  need_daemon
  if [[ ${1:-} == --json ]]; then api GET /status; echo; else
    api GET /status | jq -r '"Listening: \(.listening)\nThinking: \(.thinking)\nPending proposals: \(.pending)\nLast reply: \(.lastReply)\nCost today: $\(.todayCostUsd|.*10000|round/10000)\nBrain: \(.brain) \(.model)\nVault: \(.vault)\nDevices: \(.devices|map(.id)|join(", "))\nPort: \(.port)"'
  fi
  ;;

open-chat)
  chat=${1:-local}
  file="$(vault_path)/Conversations/$(date +%F)/${chat//:/_}.md"
  [[ -f $file ]] && xdg-open "obsidian://open?path=$file" || xdg-open "obsidian://open?path=$(vault_path)"
  ;;

"" | -h | --help)
  sed -n 's/^# omarchy:args=/usage: omarchy-assistant /p' "$0"
  ;;
*)
  echo "omarchy-assistant: unknown command '$cmd'" >&2
  exit 1
  ;;
esac
